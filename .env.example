# DEV / CLI ONLY. The desktop app takes keys in Settings (gear icon) and stores
# them encrypted per user; this file is just a fallback for development and the
# `pcb` CLI. A key saved in Settings beats the one here for the same provider.
# Copy to .env at the project root. Root .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Optional — official OpenAI:
# OPENAI_API_KEY=sk-...

# Optional — a local / OpenAI-compatible endpoint (Ollama, LM Studio, OpenRouter).
# Point it at the /v1 base; the key is optional for local runtimes. Which local
# models may call tools / read images is set per model in the app's Settings.
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_API_KEY=
